{
  "name": "clipboard-manager",
  "version": "0.1.1",
  "description": "Tray üzerinden kullanılan yerel metin ve görsel pano geçmişi",
  "main": "src/main.cjs",
  "private": true,
  "author": "Efe",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "test:smoke": "xvfb-run -a electron . --ozone-platform=x11 --smoke-test",
    "pack:win": "electron-builder --win --x64 --dir",
    "dist:win": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.efedogan.clipboardmanager",
    "productName": "Clipboard Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "zip"
      ],
      "artifactName": "Clipboard-Manager-${version}-windows-${arch}.${ext}"
    }
  }
}
